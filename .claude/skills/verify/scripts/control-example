#!/usr/bin/env bash
# .claude/skills/verify/scripts/control-example
#
# Drives packages/example, the effect-grpc example gRPC server, for verification runs.
# `control-example help` prints the commands and options.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd -P)
REPO=$(cd "$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel)" && pwd -P)
LIB=$REPO/packages/effect-grpc
EXAMPLE=$REPO/packages/example
E2E=$REPO/packages/e2e-tests
FIXTURES=$E2E/src/fixtures/hostile-requests.json
DEFAULT_HOST=127.0.0.1
DEFAULT_PORT=8000
HOST_ENV=EFFECT_GRPC_EXAMPLE_HOST
PORT_ENV=EFFECT_GRPC_EXAMPLE_PORT
SVC=com.example.v1.HelloWorldAPI
EGV_ROOT=${EGV_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/effect-grpc-verify}
# Each worktree has its own git dir, so no two checkouts share a pointer, and `git worktree remove` drops it.
CURRENT=$(git -C "$REPO" rev-parse --absolute-git-dir)/effect-grpc-verify/current
# Per-connection chatter from server.internal.ts; kept in evidence, hidden on the terminal.
NOISE='^(New TCP connection|TCP connection closed|New HTTP/2 session created|HTTP/2 session closed|New stream on session|Stream closed|HTTP/2 session GOAWAY)'

HOST_ARG=""
PORT_ARG=""
ROOT_ARG=""
ARGS=()
CMD=""
RUN=""
HOST=""
PORT=""
BASE_URL=""
DO_CALL_EVIDENCE=""

die() { echo "control-example: $*" >&2; exit 2; }

parse_args() {
  while [ $# -gt 0 ]; do
    case $1 in
      --host)
        [ $# -ge 2 ] || die "--host needs a value"
        [ -z "$HOST_ARG" ] || die "--host was given twice"
        case $2 in 127.0.0.1 | ::1) ;; *) die "--host must be 127.0.0.1 or ::1, not '$2'" ;; esac
        HOST_ARG=$2
        shift 2
        ;;
      --port)
        [ $# -ge 2 ] || die "--port needs a value"
        [ -z "$PORT_ARG" ] || die "--port was given twice"
        [[ $2 =~ ^[1-9][0-9]{0,4}$ ]] && [ "$2" -le 65535 ] || die "--port must be a whole number from 1 to 65535, not '$2'"
        PORT_ARG=$2
        shift 2
        ;;
      --root)
        [ $# -ge 2 ] || die "--root needs a value"
        [ -z "$ROOT_ARG" ] || die "--root was given twice"
        ROOT_ARG=$2
        shift 2
        ;;
      -h | --help)
        ARGS+=(help)
        shift
        ;;
      --*) die "unknown option $1; see: control-example help" ;;
      *)
        ARGS+=("$1")
        shift
        ;;
    esac
  done
}

refuse_foreign_root() {
  [ -n "$ROOT_ARG" ] || return 0
  local top
  top=$(git -C "$ROOT_ARG" rev-parse --show-toplevel 2>/dev/null) || die "--root $ROOT_ARG is not inside a git checkout"
  top=$(cd "$top" && pwd -P)
  [ "$top" = "$REPO" ] || die "--root is $top, but this script drives $REPO. Nothing was done. Run $top/.claude/skills/verify/scripts/control-example instead."
}

want_args() {
  local min=$1 max=$2
  shift 2
  [ $# -ge "$min" ] && [ $# -le "$max" ] || die "wrong number of arguments for $CMD: ${*:-none}; see: control-example help"
}

# ---------- runs and evidence ----------

run_dir() { if [ -f "$CURRENT" ]; then cat "$CURRENT"; fi; }

ensure_run() {
  local r
  r=$(run_dir)
  if [ -n "$r" ] && [ -d "$r" ]; then echo "$r"; return; fi
  r=$EGV_ROOT/runs/$(date -u +%Y%m%dT%H%M%SZ)-$$
  mkdir -p "$r/state" "$r/evidence" "$(dirname "$CURRENT")"
  {
    echo "run_id=$(basename "$r")"
    echo "started_at=$(date -u +%FT%TZ)"
    echo "root=$REPO"
    echo "skill=$SCRIPT_DIR/control-example"
    echo "git_head=$(git -C "$REPO" rev-parse HEAD)"
    echo "git_dirty_files=$(git -C "$REPO" status --porcelain | wc -l | tr -d ' ')"
  } >"$r/evidence/run.txt"
  echo "$r" >"$CURRENT"
  echo "$r"
}

url_for() { # url_for <host> <port>: a URL needs an IPv6 address in brackets
  case $1 in *:*) echo "http://[$1]:$2" ;; *) echo "http://$1:$2" ;; esac
}

load_instance() {
  RUN=$(run_dir)
  if [ -n "$RUN" ] && [ ! -d "$RUN" ]; then RUN=""; fi
  PORT=""
  HOST=$DEFAULT_HOST
  if [ -n "$RUN" ] && [ -s "$RUN/state/port" ]; then PORT=$(cat "$RUN/state/port"); fi
  if [ -n "$RUN" ] && [ -s "$RUN/state/host" ]; then HOST=$(cat "$RUN/state/host"); fi
  BASE_URL=$(url_for "$HOST" "$PORT")
}

refuse_foreign_port() {
  if [ -n "$PORT_ARG" ] && [ -n "$PORT" ] && [ "$PORT_ARG" != "$PORT" ]; then
    die "this checkout's run recorded port $PORT, not $PORT_ARG. Nothing was done."
  fi
  if [ -n "$HOST_ARG" ] && [ -n "$RUN" ] && [ "$HOST_ARG" != "$HOST" ]; then
    die "this checkout's run recorded host $HOST, not $HOST_ARG. Nothing was done."
  fi
}

next_evidence() { # next_evidence <run> <slug> -> path of the next numbered evidence file
  local n
  n=$(find "$1/evidence" -maxdepth 1 -name '[0-9][0-9]-*' | wc -l)
  printf '%s/evidence/%02d-%s.txt' "$1" $((n + 1)) "$2"
}

log_size() { if [ -f "$1" ]; then wc -c <"$1" | tr -d ' '; else echo 0; fi; }

show() { # print an evidence file without the per-connection chatter
  grep -vE "$NOISE" "$1" || true
  echo "evidence: $1"
}

# ---------- process identity and port ownership ----------

proc_start() { # start time (clock ticks since boot) of pid $1; empty when the pid is gone
  local s
  s=$(cat "/proc/$1/stat" 2>/dev/null) || return 0
  s=${s##*) }
  # shellcheck disable=SC2086
  set -- $s
  echo "${20}"
}

instance_alive() { # instance_alive <run>: the recorded pid is alive and is still the process we started
  local st=$1/state pid start
  [ -s "$st/server.pid" ] && [ -s "$st/server.start" ] || return 1
  pid=$(cat "$st/server.pid")
  start=$(cat "$st/server.start")
  [ "$(proc_start "$pid")" = "$start" ]
}

require_live() {
  [ -n "$RUN" ] && instance_alive "$RUN" || die "no live instance from this skill in $REPO; run: control-example launch"
}

decode_addr() {
  case $1 in
    0100007F) echo 127.0.0.1 ;;
    00000000) echo 0.0.0.0 ;;
    00000000000000000000000001000000) echo ::1 ;;
    00000000000000000000000000000000) echo :: ;;
    *) echo "hex:$1" ;;
  esac
}

port_listeners() {
  local port=$1 hex inode addr owner
  local files=(/proc/net/tcp)
  [ -r /proc/net/tcp ] || { echo "cannot read /proc/net/tcp" >&2; return 2; }
  [ -r /proc/net/tcp6 ] && files+=(/proc/net/tcp6)
  hex=$(printf '%04X' "$port")
  awk -v p=":$hex" 'FNR > 1 && $4 == "0A" { n = length($2); if (substr($2, n - 4) == p) print $10, substr($2, 1, n - 5) }' "${files[@]}" |
    while read -r inode addr; do
      # find exits non-zero on unreadable /proc entries and when head closes the pipe; neither means "free".
      owner=$(find /proc/[0-9]*/fd -maxdepth 1 -lname "socket:\[$inode\]" 2>/dev/null | head -n 1 | cut -d/ -f3 || true)
      echo "${owner:-?} $(decode_addr "$addr")"
    done
}

ready_address() {
  local r=$1 off
  off=$(cat "$r/state/log_offset" 2>/dev/null || echo 0)
  tail -c +"$((off + 1))" "$r/evidence/server.log" | sed -n 's|.*gRPC server listening on http://\([^ "]*\).*|\1|p' | sed -n 1p
}

# ---------- build freshness ----------

stale_report() { # prints one STALE line per out-of-date artifact; status 1 when any
  local bad=0 f out gen=$EXAMPLE/src/generated/com/example/v1/hello_world_api_effect.ts
  while IFS= read -r f; do
    out=$LIB/dist/${f#"$LIB/src/"}
    out=${out%.ts}.js
    if [ ! -f "$out" ] || [ "$f" -nt "$out" ]; then echo "STALE lib: ${out#"$REPO/"} is older than ${f#"$REPO/"}"; bad=1; fi
  done < <(find "$LIB/src" -name '*.ts' ! -name '*.d.ts' ! -name '*.test-d.ts')
  for f in server client address; do
    if [ ! -f "$EXAMPLE/dist/$f.js" ] || [ "$EXAMPLE/src/$f.ts" -nt "$EXAMPLE/dist/$f.js" ]; then echo "STALE example: packages/example/dist/$f.js"; bad=1; fi
  done
  if [ ! -f "$gen" ]; then
    echo "STALE codegen: ${gen#"$REPO/"} is missing"
    bad=1
  else
    if [ "$EXAMPLE/proto/com/example/v1/hello_world_api.proto" -nt "$gen" ]; then echo "STALE codegen: the proto is newer than the generated code"; bad=1; fi
    if [ "$LIB/src/protocGenPlugin.ts" -nt "$gen" ]; then echo "STALE codegen: protocGenPlugin.ts is newer than the generated code"; bad=1; fi
    if [ "$gen" -nt "$EXAMPLE/dist/generated/com/example/v1/hello_world_api_effect.js" ]; then echo "STALE example: generated .ts is newer than its compiled .js"; bad=1; fi
  fi
  return $bad
}

# ---------- drivers ----------

with_example_env() { # run "$@" with the example's host and port variables set only where they differ from its defaults
  local removed=() assigned=()
  if [ "$HOST" = "$DEFAULT_HOST" ]; then removed+=(-u "$HOST_ENV"); else assigned+=("$HOST_ENV=$HOST"); fi
  if [ "$PORT" = "$DEFAULT_PORT" ]; then removed+=(-u "$PORT_ENV"); else assigned+=("$PORT_ENV=$PORT"); fi
  env "${removed[@]}" "${assigned[@]}" "$@"
}

do_call() {
  local r=$1 proto=$2 method=$3 json=$4 slug=${5:-$2-$3}
  local log=$r/evidence/server.log f off rc=0 status="" out err
  local cmd=()
  case $proto in
    connect) cmd=(curl -sS --http2-prior-knowledge -H 'content-type: application/json' --data "$json" -o OUT -w '%{http_code}' "$BASE_URL/$SVC/$method") ;;
    http1) cmd=(curl -sS -H 'content-type: application/json' --data "$json" -o OUT -w '%{http_code}' "$BASE_URL/$SVC/$method") ;;
    grpc) cmd=("$EXAMPLE/node_modules/.bin/buf" curl --http2-prior-knowledge --protocol grpc --schema "$EXAMPLE/proto" -d "$json" "$BASE_URL/$SVC/$method") ;;
    *) die "call: protocol must be connect, grpc or http1" ;;
  esac
  f=$(next_evidence "$r" "$slug")
  DO_CALL_EVIDENCE=$f
  off=$(log_size "$log")
  out=$(mktemp)
  err=$(mktemp)
  local run=("${cmd[@]/#OUT/$out}")
  local shown=("${cmd[@]/#OUT/<body below>}")
  if [ "$proto" = grpc ]; then
    timeout 30 "${run[@]}" >"$out" 2>"$err" || rc=$?
  else
    status=$(timeout 30 "${run[@]}" 2>"$err") || rc=$?
  fi
  sleep 0.3 # the server writes its log lines for this call synchronously; give the stream close a moment
  {
    echo "# call $proto $method at $(date -u +%FT%TZ) port=$PORT"
    printf '$'
    printf ' %q' "${shown[@]}"
    echo
    echo "exit_code=$rc"
    if [ -n "$status" ]; then echo "http_status=$status"; fi
    if [ "$proto" = grpc ] && [ "$rc" -ne 0 ] && [ $((rc % 8)) -eq 0 ]; then echo "grpc_status_code=$((rc / 8))"; fi
    echo "--- response (stdout / body)"
    cat "$out"
    echo
    echo "--- stderr"
    cat "$err"
    echo "--- server log lines written during this call"
    tail -c +"$((off + 1))" "$log"
  } >"$f"
  rm -f "$out" "$err"
  show "$f"
  return "$rc"
}

run_node_driver() {
  local r=$1 slug=$2 label=$3
  shift 3
  local log=$r/evidence/server.log f off rc=0 out err
  f=$(next_evidence "$r" "$slug")
  off=$(log_size "$log")
  out=$(mktemp)
  err=$(mktemp)
  (cd "$EXAMPLE" && with_example_env timeout 30 "$@") >"$out" 2>"$err" || rc=$?
  sleep 0.3
  {
    echo "# $label at $(date -u +%FT%TZ) port=$PORT"
    echo "exit_code=$rc"
    echo "--- stdout"
    cat "$out"
    echo "--- stderr"
    cat "$err"
    echo "--- server log lines written during this run"
    tail -c +"$((off + 1))" "$log"
  } >"$f"
  rm -f "$out" "$err"
  show "$f"
  return "$rc"
}

# ---------- commands ----------

cmd_build() {
  cd "$REPO"
  pnpm install --frozen-lockfile
  pnpm -r run build
}

cmd_launch() {
  local r listeners rc=0
  r=$(run_dir)
  if [ -n "$r" ] && [ -d "$r" ] && instance_alive "$r"; then
    die "this checkout already has a live instance (pid $(cat "$r/state/server.pid"), port $(cat "$r/state/port" 2>/dev/null || echo unknown)); run: control-example stop"
  fi
  HOST=${HOST_ARG:-$DEFAULT_HOST}
  PORT=${PORT_ARG:-$DEFAULT_PORT}
  BASE_URL=$(url_for "$HOST" "$PORT")
  mkdir -p "$EGV_ROOT"
  listeners=$(port_listeners "$PORT") || rc=$?
  [ "$rc" -eq 0 ] || die "cannot inspect port $PORT; refusing to launch blind"
  [ -z "$listeners" ] || die "port $PORT is already in use (pid address: $listeners). It is not ours; do not stop it to make room. Pick another --port."
  if ! stale_report; then die "build output is stale; run: control-example build"; fi

  RUN=$(ensure_run)
  local st=$RUN/state log=$RUN/evidence/server.log
  mkdir -p "$st"
  rm -f "$st/server.pid" "$st/server.start" "$st/exit_code"
  echo "$PORT" >"$st/port"
  echo "$HOST" >"$st/host"
  echo "=== launch host=$HOST port=$PORT root=$REPO at $(date -u +%FT%TZ) git=$(git -C "$REPO" rev-parse HEAD)" >>"$log"
  log_size "$log" >"$st/log_offset"
  # setsid detaches the server from this shell; the wrapper sh records node's pid and exit code.
  (
    cd "$EXAMPLE"
    with_example_env setsid sh -c 'node dist/server.js </dev/null >>"$1" 2>&1 &
echo $! >"$2"
wait $!
echo $? >"$3"' sh "$log" "$st/server.pid" "$st/exit_code" </dev/null >/dev/null 2>&1 &
  )
  local i pid=""
  for i in $(seq 1 50); do
    if [ -s "$st/server.pid" ]; then break; fi
    sleep 0.1
  done
  pid=$(cat "$st/server.pid" 2>/dev/null || true)
  [ -n "$pid" ] || die "the server did not start (no pid recorded)"
  proc_start "$pid" >"$st/server.start"

  local off ready=0 addr
  off=$(cat "$st/log_offset")
  for i in $(seq 1 150); do
    if ! instance_alive "$RUN"; then
      echo "control-example: the server exited during startup (exit code $(cat "$st/exit_code" 2>/dev/null || echo unknown)). Log:" >&2
      tail -c +"$((off + 1))" "$log" | tail -n 25 >&2
      exit 1
    fi
    addr=$(ready_address "$RUN")
    if [ -n "$addr" ] && [ "$addr" != "$HOST:$PORT" ]; then
      echo "control-example: the server reports http://$addr, but this launch expects http://$HOST:$PORT; stopping it" >&2
      cmd_stop >&2 || true
      exit 1
    fi
    if [ -n "$addr" ] && port_listeners "$PORT" | grep -q "^$pid "; then
      ready=1
      break
    fi
    sleep 0.2
  done
  if [ "$ready" -ne 1 ]; then
    echo "control-example: not ready after 30s; stopping it" >&2
    cmd_stop >&2 || true
    exit 1
  fi

  local probe_rc=0
  do_call "$RUN" connect GetGreeting '{"name":"readiness-probe"}' readiness >/dev/null || probe_rc=$?
  if [ "$probe_rc" -ne 0 ] || ! grep -q '^http_status=200$' "$DO_CALL_EVIDENCE" ||
    ! grep -q 'Your name is readiness-probe' "$DO_CALL_EVIDENCE" || ! grep -q 'getGreeting called' "$DO_CALL_EVIDENCE"; then
    echo "control-example: the readiness RPC did not get this instance's greeting; see $DO_CALL_EVIDENCE" >&2
    cmd_stop >&2 || true
    exit 1
  fi

  echo "launched: pid=$pid port=$PORT listening on: $(port_listeners "$PORT" | awk '{print $2}' | sort -u | paste -sd, -)"
  echo "root:     $REPO"
  echo "run:      $RUN"
  echo "evidence: $RUN/evidence"
}

cmd_doctor() {
  local ok=1 pid st log off addr
  [ -n "$RUN" ] || { echo "FAIL no current run in $REPO; run: control-example launch"; return 1; }
  st=$RUN/state
  log=$RUN/evidence/server.log
  echo "run:  $RUN"
  echo "root: $REPO"
  if instance_alive "$RUN"; then
    pid=$(cat "$st/server.pid")
    echo "OK   instance alive: pid $pid, start time matches the launch record"
  else
    echo "FAIL no live instance from this run (recorded exit code: $(cat "$st/exit_code" 2>/dev/null || echo none))"
    return 1
  fi
  local cmdline cwd
  cmdline=$(tr '\0' ' ' <"/proc/$pid/cmdline" | sed 's/ $//')
  cwd=$(readlink "/proc/$pid/cwd" || true)
  if [ "$cmdline" = "node dist/server.js" ] && [ "$cwd" = "$EXAMPLE" ]; then
    echo "OK   process is \`$cmdline\` in packages/example"
  else
    echo "FAIL process is \`$cmdline\` in $cwd"
    ok=0
  fi
  off=$(cat "$st/log_offset" 2>/dev/null || echo 0)
  addr=$(ready_address "$RUN")
  if [ "$addr" = "$HOST:$PORT" ]; then echo "OK   log has the ready line for http://$addr"; else
    echo "FAIL log lacks the ready line for http://$HOST:$PORT${addr:+ (it reports http://$addr)}"
    ok=0
  fi
  local listeners rc=0
  listeners=$(port_listeners "$PORT") || rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "FAIL cannot inspect port $PORT"
    ok=0
  elif [ -z "$listeners" ]; then
    echo "FAIL nothing listens on port $PORT"
    ok=0
  elif echo "$listeners" | awk -v p="$pid" '$1 != p { bad = 1 } END { exit bad }'; then
    echo "OK   port $PORT is ours, listening on: $(echo "$listeners" | awk '{print $2}' | sort -u | paste -sd, -)"
  else
    echo "FAIL port $PORT has listeners we did not start: $listeners"
    ok=0
  fi
  local stale
  stale=$(stale_report || true)
  if [ -z "$stale" ]; then echo "OK   build output is current"; else
    echo "$stale" | sed 's/^/FAIL /'
    ok=0
  fi
  local head_now dirty_now last_launch
  head_now=$(git -C "$REPO" rev-parse HEAD)
  dirty_now=$(git -C "$REPO" status --porcelain | wc -l | tr -d ' ')
  last_launch=$(grep '^=== launch' "$log" | tail -n 1 || true)
  case $last_launch in
    *"git=$head_now"*) ;;
    *) echo "WARN HEAD moved since launch (now $(git -C "$REPO" rev-parse --short HEAD)); rebuild and relaunch" ;;
  esac
  echo "INFO working tree: $dirty_now changed paths (run.txt recorded $(sed -n 's/^git_dirty_files=//p' "$RUN/evidence/run.txt") at run start)"
  local crashes
  crashes=$(tail -c +"$((off + 1))" "$log" | grep -cE 'TypeError|Error \[ERR_|Uncaught' || true)
  if [ "$crashes" -gt 0 ]; then echo "WARN $crashes error lines in this instance's log since launch"; fi
  [ "$ok" -eq 1 ]
}

cmd_call() {
  local proto=${1:-} method=${2:-} json=${3:-'{"name":"verify"}'}
  [ -n "$proto" ] && [ -n "$method" ] || die "usage: control-example call <connect|grpc|http1> <Method> [json]"
  require_live
  do_call "$RUN" "$proto" "$method" "$json"
}

cmd_client() {
  require_live
  run_node_driver "$RUN" example-client "example client: node dist/client.js" node dist/client.js
}

cmd_probe() {
  local method=${1:-} name=${2:-verify}
  case $method in getGreeting | faceTheError) ;; *) die "usage: control-example probe <getGreeting|faceTheError> [name]" ;; esac
  require_live
  export PROBE_URL=$BASE_URL PROBE_METHOD=$method PROBE_NAME=$name
  run_node_driver "$RUN" "probe-$method" "effect client probe: $method name=$name url=$BASE_URL" \
    sh -c 'node --input-type=module <"$1"' sh "$SCRIPT_DIR/effect-client-probe.mjs"
}

cmd_codegen() {
  local r f g pkg rc=0
  r=$(ensure_run)
  f=$(next_evidence "$r" codegen)
  {
    echo "# codegen at $(date -u +%FT%TZ): pnpm -r run build (each package build regenerates its bindings)"
    (cd "$REPO" && pnpm -r run build) 2>&1 || rc=$?
    echo "build_exit_code=$rc"
    for pkg in "$EXAMPLE" "$E2E"; do
      echo "## generated files in ${pkg#"$REPO/"}"
      (cd "$pkg" && find src/generated -type f | sort) || echo "(none: src/generated is missing)"
      while IFS= read -r g; do
        echo "## exports of ${g#"$REPO/"}"
        grep -oE '^export (const|function|type|interface) [A-Za-z0-9_]+' "$g" | awk '{print $3}' | sort -u || true
      done < <(find "$pkg/src/generated" -name '*_effect.ts' 2>/dev/null | sort)
    done
    echo "## runtime type of the typed-tag factories (packages/example/dist)"
    (cd "$EXAMPLE" && node --input-type=module -e 'const m = await import("./dist/generated/com/example/v1/hello_world_api_effect.js"); console.log("typeof HelloWorldAPIClientTag =", typeof m.HelloWorldAPIClientTag); console.log("typeof HelloWorldAPIServiceTag =", typeof m.HelloWorldAPIServiceTag)') 2>&1 || echo "(could not import the generated module)"
  } >"$f"
  show "$f"
  return "$rc"
}

run_hostile_driver() { # run_hostile_driver <authority|message-limit> <slug>
  local mode=$1 slug=$2 r log f off rc=0 out err alive=no
  require_live
  r=$RUN
  log=$r/evidence/server.log
  f=$(next_evidence "$r" "$slug")
  off=$(log_size "$log")
  out=$(mktemp)
  err=$(mktemp)
  (cd "$EXAMPLE" && env HOSTILE_URL="$BASE_URL" HOSTILE_FIXTURES="$FIXTURES" HOSTILE_MODE="$mode" \
    timeout 60 sh -c 'node --input-type=module <"$1"' sh "$SCRIPT_DIR/hostile-requests.mjs") >"$out" 2>"$err" || rc=$?
  sleep 0.3
  if instance_alive "$r"; then alive=yes; fi
  {
    echo "# $slug at $(date -u +%FT%TZ) url=$BASE_URL port=$PORT: the $mode cases in ${FIXTURES#"$REPO/"}"
    echo "driver_exit_code=$rc"
    echo "server_alive_after=$alive"
    if [ "$alive" = no ]; then echo "server_exit_code=$(cat "$r/state/exit_code" 2>/dev/null || echo unknown)"; fi
    echo "verdict=$([ "$rc" -eq 0 ] && [ "$alive" = yes ] && echo PASS || echo FAIL)"
    echo "--- checks, one JSON line each, then the driver's verdict"
    cat "$out"
    echo "--- stderr"
    cat "$err"
    echo "--- server log lines written during these requests"
    tail -c +"$((off + 1))" "$log"
  } >"$f"
  rm -f "$out" "$err"
  show "$f"
  [ "$rc" -eq 0 ] && [ "$alive" = yes ]
}

cmd_hostile_authority() { run_hostile_driver authority hostile-authority; }

cmd_message_limit() { run_hostile_driver message-limit message-limit; }

cmd_stop() {
  local st log pid f off i graceful=yes code
  [ -n "$RUN" ] || { echo "no current run"; return 0; }
  st=$RUN/state
  log=$RUN/evidence/server.log
  if ! instance_alive "$RUN"; then
    echo "no live instance in run $(basename "$RUN") (already stopped or crashed; recorded exit code: $(cat "$st/exit_code" 2>/dev/null || echo none))"
    rm -f "$st/server.pid" "$st/server.start"
    return 0
  fi
  pid=$(cat "$st/server.pid")
  f=$(next_evidence "$RUN" stop)
  off=$(log_size "$log")
  kill -TERM "$pid"
  for i in $(seq 1 50); do
    instance_alive "$RUN" || break
    sleep 0.2
  done
  if instance_alive "$RUN"; then
    graceful=no
    kill -KILL "$pid"
  fi
  for i in $(seq 1 25); do
    if [ -s "$st/exit_code" ]; then break; fi
    sleep 0.2
  done
  code=$(cat "$st/exit_code" 2>/dev/null || echo unknown)
  {
    echo "# stop at $(date -u +%FT%TZ): SIGTERM to pid $pid (identity checked by start time)"
    echo "graceful=$graceful"
    echo "exit_code=$code"
    echo "port=$PORT"
    echo "port_listeners_after=$(port_listeners "$PORT" | paste -sd, - || echo unknown)"
    echo "--- server log lines written during shutdown"
    tail -c +"$((off + 1))" "$log"
  } >"$f"
  rm -f "$st/server.pid" "$st/server.start"
  show "$f"
  [ "$graceful" = yes ]
}

cmd_cleanup() {
  if [ -z "$RUN" ]; then
    rm -f "$CURRENT"
    echo "nothing to clean up"
    return 0
  fi
  if instance_alive "$RUN"; then cmd_stop || true; fi
  rm -rf "$RUN/state"
  rm -f "$CURRENT"
  echo "cleaned up run $(basename "$RUN"); evidence kept at $RUN/evidence:"
  ls -1 "$RUN/evidence"
}

cmd_evidence() {
  [ -n "$RUN" ] || die "no current run in $REPO"
  echo "$RUN/evidence"
  ls -1 "$RUN/evidence"
}

usage() {
  cat <<'EOF'
Drives packages/example, the effect-grpc example gRPC server, for verification runs.
Each checkout runs at most one instance. Instances in different checkouts run side by side on different ports.

Usage: control-example <command> [arguments] [--port <n>] [--host <address>] [--root <path>]
  build                                      pnpm install --frozen-lockfile, then pnpm -r run build
  launch                                     start `node dist/server.js` on <host>:<port>, detached; wait until it serves an RPC
  doctor                                     read-only check of this checkout's instance
  call <connect|grpc|http1> <Method> [json]  one unary call; records the response and the server log lines
  client                                     run the README example client (`node dist/client.js`) against the instance
  probe <getGreeting|faceTheError> [name]    call the instance through the generated Effect client
  codegen                                    rebuild everything (codegen included) and record generated exports
  hostile-authority                          send the fixture's authority cases over gRPC and Connect; check each reply
  message-limit                              send messages at and over the 4 MiB limit; check each reply
  stop                                       SIGTERM this checkout's instance; record the shutdown
  cleanup                                    stop if running, drop instance state, keep evidence
  evidence                                   print this checkout's current evidence directory

  --port <n>     launch serves on port n (1-65535, default 8000). Every other command refuses
                 when this checkout's run recorded a different port.
  --host <addr>  launch binds 127.0.0.1 (the default) or ::1. Every other command refuses
                 when this checkout's run recorded a different host.
  --root <path>  refuse unless <path> is inside the checkout this script belongs to.
  Options may come anywhere after the script path. A refusal exits 2 and changes nothing.

The run pointer is <the checkout's git dir>/effect-grpc-verify/current. Runs live under
${EGV_ROOT:-${XDG_STATE_HOME:-~/.local/state}/effect-grpc-verify}/runs/<run-id>/{state,evidence}.
EOF
}

main() {
  parse_args "$@"
  set -- "${ARGS[@]}"
  CMD=${1:-help}
  shift || true
  refuse_foreign_root
  case $CMD in
    launch | help) ;;
    *)
      load_instance
      refuse_foreign_port
      ;;
  esac
  case $CMD in
    build) want_args 0 0 "$@"; cmd_build ;;
    launch) want_args 0 0 "$@"; cmd_launch ;;
    doctor) want_args 0 0 "$@"; cmd_doctor ;;
    call) want_args 2 3 "$@"; cmd_call "$@" ;;
    client) want_args 0 0 "$@"; cmd_client ;;
    probe) want_args 1 2 "$@"; cmd_probe "$@" ;;
    codegen) want_args 0 0 "$@"; cmd_codegen ;;
    hostile-authority) want_args 0 0 "$@"; cmd_hostile_authority ;;
    message-limit) want_args 0 0 "$@"; cmd_message_limit ;;
    stop) want_args 0 0 "$@"; cmd_stop ;;
    cleanup) want_args 0 0 "$@"; cmd_cleanup ;;
    evidence) want_args 0 0 "$@"; cmd_evidence ;;
    help) usage ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
