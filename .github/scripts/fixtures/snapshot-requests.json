[
  {
    "name": "a collaborator's /snapshot on a same-repo PR uses the push CI run, not the pull_request run listed first",
    "event": {
      "eventName": "issue_comment",
      "sha": "448c926bb07e5bac8f41cef3f0d3d5490d663770",
      "payload": {
        "action": "created",
        "comment": { "body": "/snapshot", "author_association": "COLLABORATOR" },
        "issue": { "number": 83, "pull_request": { "url": "https://api.github.com/repos/Dr-Nikson/effect-grpc/pulls/83" } }
      }
    },
    "pullRequest": { "sha": "1092b7f3ad43a293c48e61af1334444674f5148e", "repository": "Dr-Nikson/effect-grpc" },
    "runs": [
      { "id": 45314334420, "event": "pull_request", "conclusion": "success", "headSha": "1092b7f3ad43a293c48e61af1334444674f5148e" },
      { "id": 45314327524, "event": "push", "conclusion": "success", "headSha": "1092b7f3ad43a293c48e61af1334444674f5148e" }
    ],
    "artifacts": {
      "45314334420": [{ "name": "build-artifacts-16ae5ca38965dddbb8566ac7d5797d0904ed0af7", "expired": false }],
      "45314327524": [{ "name": "build-artifacts-1092b7f3ad43a293c48e61af1334444674f5148e", "expired": false }]
    },
    "expect": {
      "kind": "allowed",
      "tag": "pr-83",
      "sha": "1092b7f3ad43a293c48e61af1334444674f5148e",
      "runId": 45314327524,
      "artifact": "build-artifacts-1092b7f3ad43a293c48e61af1334444674f5148e",
      "prNumber": 83,
      "reply": true
    }
  },
  {
    "name": "an owner names a tag after /snapshot, and later lines of the comment are ignored",
    "event": {
      "eventName": "issue_comment",
      "sha": "448c926bb07e5bac8f41cef3f0d3d5490d663770",
      "payload": {
        "action": "created",
        "comment": { "body": "/snapshot mvp\nTrying the new client here.", "author_association": "OWNER" },
        "issue": { "number": 83, "pull_request": { "url": "https://api.github.com/repos/Dr-Nikson/effect-grpc/pulls/83" } }
      }
    },
    "pullRequest": { "sha": "1092b7f3ad43a293c48e61af1334444674f5148e", "repository": "Dr-Nikson/effect-grpc" },
    "runs": [{ "id": 45314327524, "event": "push", "conclusion": "success", "headSha": "1092b7f3ad43a293c48e61af1334444674f5148e" }],
    "artifacts": { "45314327524": [{ "name": "build-artifacts-1092b7f3ad43a293c48e61af1334444674f5148e", "expired": false }] },
    "expect": { "kind": "allowed", "tag": "mvp", "prNumber": 83, "reply": true }
  },
  {
