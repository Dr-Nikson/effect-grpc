{
  "supported": [
    {
      "name": "takes the oldest and the newest release in the peer range, never a prerelease or a later major",
      "peers": { "effect": "catalog:peer", "@effect/opentelemetry": "catalog:peer" },
      "catalogs": { "peer": { "effect": "^4.0.7", "@effect/opentelemetry": "^4.0.7" } },
      "published": [
        "3.19.15",
        "3.22.5",
        "4.0.0-beta.107",
        "4.0.0-rc.118",
        "4.0.0",
        "4.0.6",
        "4.0.7",
        "4.1.0",
        "4.1.5",
        "4.2.0-beta.1",
        "5.0.0-alpha.0",
        "5.0.0"
      ],
      "oldest": "4.0.7",
      "newest": "4.1.5"
    },
    {
      "name": "skips npm entries that are not plain versions",
      "peers": { "effect": "^4.0.7" },
      "published": [
        "4.0.7",
        "v4.9.0",
        " 4.8.0",
        "4.7.0\nnewest=0.0.0",
        "4.6.0+build",
        "latest",
        "",
        null,
        4.5,
        "4.1.5"
      ],
      "oldest": "4.0.7",
      "newest": "4.1.5"
    },
    {
      "name": "reads the floor from the peer catalog, not from the default catalog that holds the installed release",
      "peers": { "effect": "catalog:peer" },
      "catalogs": { "default": { "effect": "4.1.5" }, "peer": { "effect": "^4.0.7" } },
      "published": ["4.0.7", "4.1.0", "4.1.5"],
      "oldest": "4.0.7",
      "newest": "4.1.5"
    },
    {
      "name": "reads the range from the default catalog",
      "peers": { "effect": "catalog:" },
      "catalog": { "effect": "^4.1.0" },
      "published": ["4.0.7", "4.1.0", "4.1.5"],
      "oldest": "4.1.0",
      "newest": "4.1.5"
    },
    {
      "name": "refuses a range that no published release satisfies",
      "peers": { "effect": "^4.9.0" },
      "published": ["4.0.7", "4.1.5"],
      "refused": "No published effect release satisfies ^4.9.0"
    },
    {
      "name": "refuses an Effect peer that rejects the oldest release",
      "peers": { "effect": "catalog:peer", "@effect/opentelemetry": "catalog:peer" },
      "catalogs": { "peer": { "effect": "^4.0.7", "@effect/opentelemetry": "^4.1.5" } },
      "published": ["4.0.7", "4.1.5"],
      "refused": "@effect/opentelemetry peer range ^4.1.5"
    }
  ],
  "lockfiles": [
    {
