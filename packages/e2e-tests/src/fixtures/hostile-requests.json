    { "case": "an unclosed IPv6 bracket", "authority": "[::1" },
    { "case": "an unbracketed IPv6 address with an out-of-range port", "authority": "::1:99999" },
    { "case": "an unbracketed IPv6 address with no port", "authority": "::1" },
