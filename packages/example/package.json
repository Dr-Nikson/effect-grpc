{
  "name": "@dr_nikson/effect-grpc-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "compile": "tsc --build tsconfig.json",
    "clean": "rm -rf ./dist ./tsconfig.tsbuildinfo",
    "generate:proto": "pnpm buf generate",
    "build": "pnpm run clean && pnpm run generate:proto && pnpm run compile"
  },
  "dependencies": {
    "effect": "catalog:",
    "@bufbuild/protobuf": "catalog:",
    "@connectrpc/connect": "catalog:",
    "@dr_nikson/effect-grpc": "workspace:3.0.0-alpha.5"
  },
  "devDependencies": {
    "@bufbuild/buf": "catalog:",
    "@bufbuild/protoc-gen-es": "catalog:",
    "@effect/cluster": "catalog:",
    "@effect/experimental": "catalog:",
    "@effect/platform": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/rpc": "catalog:",
    "@effect/sql": "catalog:",
    "@effect/workflow": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}